---
import Icon from "./Icon.astro";
---
<section class="py-20 sm:py-28">
  <div class="container-site">
    <div class="reveal relative overflow-hidden rounded-[2.5rem] bg-ink px-6 py-16 text-center text-white sm:px-12">
      <div aria-hidden="true" class="absolute -top-20 -left-20 h-64 w-64 rounded-full bg-rose-600/40 blur-3xl"></div>
      <div aria-hidden="true" class="absolute -right-16 -bottom-24 h-72 w-72 rounded-full bg-gold/40 blur-3xl"></div>
      <div class="relative">
        <p class="font-script text-3xl text-blush-200">Let's celebrate</p>
        <h2 class="mx-auto mt-2 max-w-2xl text-3xl leading-tight sm:text-5xl">Your date won't hold itself. Let's start planning.</h2>
        <p class="mx-auto mt-5 max-w-xl text-white/75">Pick a package, add your details, and your message is ready to send in a minute.</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="#book" data-book class="btn-primary text-base"><Icon name="sparkle" /> Start my booking request</a>
        </div>
      </div>
    </div>
  </div>
</section>
