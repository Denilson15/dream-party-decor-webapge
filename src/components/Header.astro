---
import { site } from "../config/site";
import Icon from "./Icon.astro";
const links = [
  { href: "#services", label: "Services" },
  { href: "#gallery", label: "Gallery" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#about", label: "About" },
  { href: "#faq", label: "FAQ" },
];
---
<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="container-site flex h-18 items-center justify-between gap-4 py-3">
    <a href="#top" class="flex items-center gap-3">
      <img src="/images/logo.jpg" alt="" width="44" height="44" class="h-11 w-11 rounded-full ring-2 ring-white shadow" />
      <span class="leading-tight">
        <span class="block font-serif text-lg font-semibold">{site.name}</span>
        <span class="block font-script text-base text-rose-600 -mt-1">by {site.owner}</span>
      </span>
    </a>
    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {links.map((l) => <a href={l.href} class="text-sm font-medium text-ink-soft transition hover:text-rose-600">{l.label}</a>)}
      <a href={site.instagram.dm} target="_blank" rel="noopener" class="btn-primary !px-5 !py-2.5">
        <Icon name="instagram" class="h-4 w-4" /> Book your date
      </a>
    </nav>
    <button id="menu-toggle" class="rounded-full p-2 lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span data-open><Icon name="menu" class="h-6 w-6" /></span>
      <span data-close class="hidden"><Icon name="close" class="h-6 w-6" /></span>
    </button>
  </div>
  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-blush-200 bg-cream shadow-xl lg:hidden">
    <div class="container-site flex flex-col py-4">
      {links.map((l) => <a href={l.href} class="border-b border-blush-100 py-3 font-medium">{l.label}</a>)}
      <a href={site.instagram.dm} target="_blank" rel="noopener" class="btn-primary mt-4">
        <Icon name="instagram" class="h-4 w-4" /> Book your date
      </a>
    </div>
  </nav>
</header>
<script>
  const header = document.getElementById("site-header")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const setScrolled = () => header.classList.toggle("header-scrolled", window.scrollY > 20);
  setScrolled();
  window.addEventListener("scroll", setScrolled, { passive: true });
  const setOpen = (open: boolean) => {
    menu.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    toggle.querySelector("[data-open]")!.classList.toggle("hidden", open);
    toggle.querySelector("[data-close]")!.classList.toggle("hidden", !open);
    header.classList.toggle("header-scrolled", open || window.scrollY > 20);
  };
  toggle.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
<style>
  .header-scrolled {
    background: rgb(255 248 243 / 0.92);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 rgb(45 34 38 / 0.06), 0 8px 24px -12px rgb(45 34 38 / 0.15);
  }
</style>
