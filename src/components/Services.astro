---
import { services } from "../data/services";
import { site } from "../config/site";
import Icon from "./Icon.astro";
const packages = services.filter((s) => s.group === "package");
const rentals = services.filter((s) => s.group === "rental");
---
<section id="services" class="py-20 sm:py-28">
  <div class="container-site">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Services & packages</p>
      <h2 class="section-title">Decor that turns any space into <em class="text-rose-600">the moment</em></h2>
      <p class="mt-4 text-ink-soft">Every design is custom. Pick a starting point, tell us your theme, and we'll tailor it to your event and budget.</p>
    </div>

    <h3 class="reveal mt-14 text-center font-sans text-sm font-semibold uppercase tracking-[0.2em] text-ink-soft">Decor packages</h3>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {packages.map((s) => (
        <article class:list={[
          "reveal relative flex flex-col rounded-3xl border bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl",
          s.featured ? "border-rose-600 ring-1 ring-rose-600" : "border-blush-200",
        ]}>
          {s.featured && <span class="absolute -top-3 left-6 rounded-full bg-rose-600 px-3 py-1 text-xs font-semibold text-white">Most popular</span>}
          <p class="text-xs font-semibold uppercase tracking-widest text-gold">{s.category}</p>
          <h4 class="mt-2 font-serif text-xl font-semibold">{s.title}</h4>
          <p class="mt-3 flex items-baseline gap-1">
            <span class="text-xs text-ink-soft">Starting at</span>
            <span class="font-serif text-3xl font-semibold text-ink">{s.price}</span>
            {s.unit && <span class="text-sm text-ink-soft">{s.unit}</span>}
          </p>
          <p class="mt-3 text-sm text-ink-soft">{s.description}</p>
          <ul class="mt-4 space-y-2 text-sm">
            {s.includes.map((i) => <li class="flex gap-2"><Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-rose-600" />{i}</li>)}
          </ul>
          <div class="mt-auto pt-6">
            <a href="#book" data-book data-package={s.title} class:list={[s.featured ? "btn-primary" : "btn-ghost", "w-full"]}>
              Book this package<span class="sr-only">: {s.title}</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <h3 class="reveal mt-16 text-center font-sans text-sm font-semibold uppercase tracking-[0.2em] text-ink-soft">Rentals & extras</h3>
    <p class="mt-2 text-center text-sm text-ink-soft">Book on their own or add them to any package.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {rentals.map((s) => (
        <article class="reveal flex flex-col rounded-2xl border border-blush-200 bg-white p-5 transition hover:border-rose-600 hover:shadow-lg">
          <div class="flex items-start justify-between gap-3">
            <h4 class="font-serif text-lg font-semibold leading-snug">{s.title}</h4>
            <p class="shrink-0 text-right leading-tight">
              <span class="block text-[0.65rem] uppercase tracking-wider text-ink-soft">from</span>
              <span class="font-serif text-xl font-semibold">{s.price}</span>
              {s.unit && <span class="block text-xs text-ink-soft">{s.unit}</span>}
            </p>
          </div>
          <p class="mt-2 flex-1 text-sm text-ink-soft">{s.description}</p>
          <a href="#book" data-book data-package={s.title} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-rose-600 hover:underline">
            Book<span class="sr-only"> {s.title}</span> <Icon name="arrow" class="h-4 w-4" />
          </a>
        </article>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-ink-soft">
      Final pricing depends on size, design and location. Delivery is included locally; a travel fee may apply outside the {site.serviceArea}.
    </p>
  </div>
</section>
