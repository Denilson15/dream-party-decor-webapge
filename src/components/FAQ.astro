---
import { faq } from "../data/faq";
---
<section id="faq" class="bg-white py-20 sm:py-28">
  <div class="container-site max-w-3xl">
    <div class="reveal text-center">
      <p class="eyebrow">FAQ</p>
      <h2 class="section-title">Good to know</h2>
    </div>
    <div class="mt-12 divide-y divide-blush-200 rounded-3xl border border-blush-200 bg-cream">
      {faq.map((f) => (
        <details class="group px-6 py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-blush-100 text-rose-600 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
