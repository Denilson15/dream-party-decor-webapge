---
import Icon from "./Icon.astro";
const items = ["Delivery & setup included", "Custom colors & themes", "Castro Valley based", "Licensed LLC"];
---
<section aria-label="Why book with us" class="border-y border-blush-200 bg-white">
  <ul class="container-site grid grid-cols-2 gap-4 py-6 text-sm font-medium text-ink-soft md:grid-cols-4">
    {items.map((i) => (
      <li class="flex items-center justify-center gap-2 text-center">
        <Icon name="check" class="h-4 w-4 shrink-0 text-gold" /> {i}
      </li>
    ))}
  </ul>
</section>
