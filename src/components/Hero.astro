---
import { site } from "../config/site";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
---
<section id="top" class="relative overflow-hidden bg-gradient-to-b from-blush-100 via-blush-50 to-cream pt-28 pb-16 sm:pt-36 lg:pb-24">
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-blush-200/60 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-1/2 -left-32 h-72 w-72 rounded-full bg-gold-light/50 blur-3xl"></div>
  <div class="container-site relative grid items-center gap-12 lg:grid-cols-2">
    <div class="reveal">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/80 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft shadow-sm">
        <Icon name="pin" class="h-4 w-4 text-rose-600" /> Serving the {site.serviceArea}
      </p>
      <h1 class="mt-6 text-4xl leading-[1.08] font-semibold sm:text-5xl lg:text-6xl">
        Make your <em class="text-rose-600">dream event</em> come true.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink-soft">
        Custom balloon garlands, photo-ready backdrops, marquee letters and party rentals. Designed around your theme, then delivered and set up so you can simply celebrate.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#book" data-book class="btn-primary text-base">
          <Icon name="sparkle" /> Book your date
        </a>
        <a href="#gallery" class="btn-ghost text-base">See our work <Icon name="arrow" class="h-4 w-4" /></a>
      </div>
      <div class="mt-8 flex items-center gap-3 text-sm text-ink-soft">
        <span class="flex text-gold">{[1,2,3,4,5].map(() => <Icon name="star" class="h-4 w-4" />)}</span>
        Loved by East Bay families for birthdays, showers & grads
      </div>
    </div>
    <div class="reveal relative mx-auto w-full max-w-lg">
      <div class="grid grid-cols-5 grid-rows-6 gap-3 sm:gap-4 h-[26rem] sm:h-[32rem]">
        <div class="col-span-3 row-span-6 overflow-hidden rounded-t-full rounded-b-3xl shadow-xl ring-4 ring-white">
          <Photo alt="Balloon backdrop setup by Dream Party Decor" label="Hero photo" />
        </div>
        <div class="col-span-2 row-span-3 overflow-hidden rounded-3xl shadow-lg ring-4 ring-white">
          <Photo alt="Light-up marquee letters with balloon garland" label="Marquee letters" />
        </div>
        <div class="col-span-2 row-span-3 overflow-hidden rounded-3xl shadow-lg ring-4 ring-white">
          <Photo alt="Themed dessert table with balloons" label="Dessert table" />
        </div>
      </div>
      <div class="absolute -bottom-6 -left-4 flex items-center gap-3 rounded-2xl bg-white px-5 py-4 shadow-xl sm:-left-8">
        <span class="grid h-11 w-11 place-items-center rounded-full bg-blush-100 text-rose-600"><Icon name="sparkle" /></span>
        <span class="text-sm leading-tight"><strong class="block font-serif text-lg">{site.postsCount}</strong> setups on Instagram</span>
      </div>
    </div>
  </div>
</section>
